# ==============================================================================
# JARVIS / AIVY OS - 远程大模型连接配置 (.env)
# ==============================================================================
# 本系统支持所有兼容 OpenAI 格式的大模型服务商（DeepSeek、阿里通义千问、Kimi、OpenAI、本地 Ollama 等）
# 复制当前文件并重命名为 ".env"，填入您的 API 密钥与地址即可。

# 1. 必填：您的远程大模型 API Key
LLM_API_KEY=sk-your-api-key-here

# 2. 必填：大模型服务接口根地址 (Base URL)
# 常用服务商参考：
# - DeepSeek:       https://api.deepseek.com/v1
# - 通义千问 (Qwen): https://dashscope.aliyuncs.com/compatible-mode/v1
# - Moonshot (Kimi): https://api.moonshot.cn/v1
# - 智谱 GLM:       https://open.bigmodel.cn/api/paas/v4
# - OpenAI 原版:    https://api.openai.com/v1
# - 本地 Ollama:    http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 3. 必填：所使用的模型名称 (Model Name)
# 参考：
# - 智谱 GLM:   GLM-4.7-Flash 或 glm-4-flash
# - DeepSeek:   deepseek-chat
# - 通义千问:   qwen-plus 或 qwen-max
# - Kimi:       moonshot-v1-8k
# - OpenAI:     gpt-4o 或 gpt-4o-mini
# - Ollama:     qwen2.5:7b 或 llama3
LLM_MODEL=GLM-4.7-Flash

# 4. 可选：独立的文生图专用大模型与 AppKey 配置 (Text-to-Image)
# 如果希望文生图使用专门的模型或另一个服务商（如 CogView、DALL-E 3、硅基流动 Flux 等）：
# 若留空，系统会自动尝试复用上方 LLM_* 配置、或本地 SD WebUI (127.0.0.1:7860)、或内置矢量引擎。
# 常见配置范例：
# - 智谱 CogView:     IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4  IMAGE_MODEL=cogview-3-plus
# - OpenAI DALL-E 3:  IMAGE_BASE_URL=https://api.openai.com/v1             IMAGE_MODEL=dall-e-3
# - 硅基流动 Flux:    IMAGE_BASE_URL=https://api.siliconflow.cn/v1         IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# IMAGE_API_KEY=your_image_appkey_here
# IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGE_MODEL=cogview-3-plus

# 5. 可选：个人邮箱服务配置（用于真实邮件收发与摘要，留空则不会开启）
# EMAIL_USER=your_email@qq.com
# EMAIL_PASS=your_authorization_code_here
# EMAIL_IMAP_SERVER=imap.qq.com
# EMAIL_SMTP_SERVER=smtp.qq.com

