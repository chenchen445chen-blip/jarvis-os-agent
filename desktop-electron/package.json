{
  "name": "jarvis-os-desktop",
  "version": "1.0.0",
  "description": "JARVIS / AIVY OS - 桌面级私人 AI 智能体前端客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "jarvis",
    "aivy",
    "desktop-agent",
    "threejs",
    "frontend-client"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jarvis.desktop.agent",
    "productName": "JarvisOS",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend"
      }
    ]
  }
}
